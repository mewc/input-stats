# --- Postgres (Railway injects DATABASE_URL automatically when you attach the plugin) ---
DATABASE_URL=postgres://user:pass@host:5432/railway

# --- BetterAuth ---
# Public URL of THIS service (Railway domain, e.g. https://input-stats-cloud.up.railway.app)
BETTER_AUTH_URL=http://localhost:3000
# 32+ random bytes. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-openssl-rand-base64-32

# --- Google OAuth (console.cloud.google.com -> Credentials -> OAuth client, type "Web application") ---
# Authorized redirect URI must be: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxx

# Custom URL scheme the macOS app registers; browser redirects here after connect.
APP_URL_SCHEME=inputstats
